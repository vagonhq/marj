{
  "name": "@vagonhq/marj",
  "version": "0.1.0",
  "description": "Local git diff review in your browser — comment on a line, your running Claude Code session answers inline and can fix the code.",
  "keywords": [
    "git",
    "diff",
    "code-review",
    "claude",
    "claude-code",
    "ai",
    "agent",
    "cli"
  ],
  "license": "MIT",
  "author": "Sezer İstif (https://github.com/sezeristif)",
  "homepage": "https://github.com/vagonhq/marj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagonhq/marj.git"
  },
  "bugs": {
    "url": "https://github.com/vagonhq/marj/issues"
  },
  "type": "module",
  "bin": {
    "marj": "dist/server/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "dev:server": "tsc -p tsconfig.server.json --watch",
    "dev:client": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@primer/octicons-react": "^19.33.0",
    "@primer/primitives": "^11.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
